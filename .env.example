# Local development only. Copy to .env and replace the two placeholder secrets.
DJANGO_SECRET_KEY=replace-with-a-long-random-local-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

POSTGRES_DB=ye
POSTGRES_USER=ye
POSTGRES_PASSWORD=replace-with-a-random-local-db-password
POSTGRES_HOST=db
POSTGRES_PORT=5432
